<Window
    x:Class="AA.Annotate.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:AA.Annotate.App.Views"
    Width="960"
    Height="540"
    Title="AA.Annotate"
    Background="Transparent"
    CanResize="False"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaChromeHints="NoChrome"
    ExtendClientAreaTitleBarHeightHint="-1"
    SystemDecorations="None"
    ShowInTaskbar="False"
    Topmost="True"
    TransparencyLevelHint="Transparent">
  <Grid Name="RootGrid" Background="Transparent">
    <views:ScreenshotSurface Name="ScreenshotSurface" />
    <views:BlurredCropMask Name="BlurredCropMask" IsVisible="False" />
    <Canvas Name="AnnotationCanvas" Background="Transparent" />
    <views:CropOverlay Name="CropOverlay" IsVisible="False" />
    <Canvas Name="ChromeCanvas">
      <views:CommentEditor Name="CommentEditor" Canvas.Left="180" Canvas.Top="180" IsVisible="False" />
      <Border Name="OverlayCreationHint"
              IsVisible="False"
              IsHitTestVisible="False"
              ZIndex="300"
              MaxWidth="360"
              Padding="9,5"
              Background="{StaticResource PanelSurfaceBrush}"
              BorderBrush="{StaticResource OverlayBorderBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource RadiusSmall}">
        <TextBlock Name="OverlayCreationHintText"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
      </Border>
    </Canvas>
    <Canvas Name="EmbeddedToolbarLayer" IsVisible="False">
      <ContentControl Name="EmbeddedToolbarHost" />
    </Canvas>
    <Grid Name="IdleWarningOverlay"
          IsVisible="False"
          Background="#A0000000">
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="420"
              Padding="18"
              Background="{StaticResource OverlayActiveBrush}"
              BorderBrush="{StaticResource OverlayBorderBrush}"
              BorderThickness="1"
              CornerRadius="10">
        <StackPanel Spacing="14">
          <TextBlock Name="IdleWarningTitleText"
                     Text="Annotation session is idle"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     FontSize="18"
                     FontWeight="SemiBold" />
          <TextBlock Name="IdleWarningMessageText"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     FontSize="13"
                     TextWrapping="Wrap" />
          <TextBlock Name="IdleWarningCountdownText"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     FontSize="13"
                     FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button Name="IdleWarningContinueButton"
                    Classes="activeIconButton"
                    MinWidth="92"
                    Height="36"
                    Content="Continue" />
            <Button Name="IdleWarningDiscardButton"
                    Classes="iconButton"
                    MinWidth="92"
                    Height="36"
                    Content="Discard" />
            <Button Name="IdleWarningSendButton"
                    Classes="confirmButton"
                    MinWidth="92"
                    Height="36"
                    Content="Send" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
    <Grid Name="SessionConfirmationOverlay"
          IsVisible="False"
          Focusable="True"
          Background="#A0000000">
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="420"
              Padding="18"
              Background="{StaticResource OverlayActiveBrush}"
              BorderBrush="{StaticResource OverlayBorderBrush}"
              BorderThickness="1"
              CornerRadius="10">
        <StackPanel Spacing="14">
          <TextBlock Name="SessionConfirmationTitleText"
                     Text="Finish annotation session?"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     FontSize="18"
                     FontWeight="SemiBold" />
          <TextBlock Name="SessionConfirmationMessageText"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     FontSize="13"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button Name="SessionConfirmationCancelButton"
                    Classes="iconButton"
                    MinWidth="104"
                    Height="36"
                    Content="Keep editing" />
            <Button Name="SessionConfirmationConfirmButton"
                    Classes="confirmButton"
                    MinWidth="104"
                    Height="36"
                    Content="Finish" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
