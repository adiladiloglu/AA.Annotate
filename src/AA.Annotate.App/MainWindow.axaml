<Window
    x:Class="AA.Annotate.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Avalonia.Controls.Primitives"
    xmlns:views="clr-namespace:AA.Annotate.App.Views"
    Width="960"
    Height="540"
    Title="AA Annotate"
    Background="Transparent"
    CanResize="False"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaChromeHints="NoChrome"
    ExtendClientAreaTitleBarHeightHint="-1"
    SystemDecorations="None"
    ShowInTaskbar="False"
    TransparencyLevelHint="Transparent"
    Topmost="True">
  <Grid Name="RootGrid" Background="Transparent">
    <views:ScreenshotSurface Name="ScreenshotSurface" />
    <views:BlurredCropMask Name="BlurredCropMask" IsVisible="False" />
    <Canvas Name="AnnotationCanvas" Background="Transparent" />
    <views:CropOverlay Name="CropOverlay" IsVisible="False" />
    <Canvas Name="ChromeCanvas">
      <views:FloatingCommandBar Name="CommandBar" Canvas.Left="24" Canvas.Top="24" />
      <views:CaptureScaleSelector Name="CaptureScaleSelector" Canvas.Left="24" Canvas.Top="74" />
      <primitives:Popup Name="DisplayDropdownPopup"
                        PlacementTarget="{Binding #CommandBar}"
                        Placement="BottomEdgeAlignedLeft"
                        VerticalOffset="6">
        <views:DisplayDropdown Name="DisplayDropdown" />
      </primitives:Popup>
      <primitives:Popup Name="CaptureDropdownPopup"
                        PlacementTarget="{Binding #CommandBar}"
                        Placement="BottomEdgeAlignedLeft"
                        HorizontalOffset="82"
                        VerticalOffset="6">
        <views:CaptureDropdown Name="CaptureDropdown" />
      </primitives:Popup>
      <primitives:Popup Name="CaptureStatusPopup"
                        PlacementTarget="{Binding #CommandBar}"
                        Placement="BottomEdgeAlignedLeft"
                        VerticalOffset="6">
        <Border Name="CaptureStatusPanel"
                Width="360"
                Padding="14"
                CornerRadius="{StaticResource RadiusLarge}"
                Background="{StaticResource PanelSurfaceBrush}"
                BorderBrush="{StaticResource OverlayBorderBrush}"
                BorderThickness="1">
          <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
            <TextBlock Name="CaptureStatusTitleText"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Name="CaptureStatusDismissButton"
                    Grid.Column="1"
                    Classes="iconButton"
                    Width="26"
                    Height="26"
                    ToolTip.Tip="Dismiss">
              <PathIcon Width="13" Height="13" Data="M6.4,5 L12,10.6 L17.6,5 L19,6.4 L13.4,12 L19,17.6 L17.6,19 L12,13.4 L6.4,19 L5,17.6 L10.6,12 L5,6.4 Z" />
            </Button>
            <TextBlock Name="CaptureStatusMessageText"
                       Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Foreground="#EAF7FBFF"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </Grid>
        </Border>
      </primitives:Popup>
      <views:CommentEditor Name="CommentEditor" Canvas.Left="180" Canvas.Top="180" IsVisible="False" />
      <primitives:Popup Name="AboutPanelPopup"
                        PlacementTarget="{Binding #CommandBar}"
                        Placement="BottomEdgeAlignedLeft"
                        HorizontalOffset="164"
                        VerticalOffset="6">
      <Border Name="AboutPanel"
              Width="236"
              Padding="12"
              CornerRadius="{StaticResource RadiusLarge}"
              Background="{StaticResource PanelSurfaceBrush}"
              BorderBrush="{StaticResource OverlayBorderBrush}"
              BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnDefinitions="*,Auto"
              RowSpacing="7">
          <TextBlock Text="AA Annotate"
                     Foreground="White"
                     FontSize="14"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <Button Name="AboutCloseButton"
                  Grid.Column="1"
                  Classes="iconButton"
                  Width="26"
                  Height="26"
                  ToolTip.Tip="Close">
            <PathIcon Width="13" Height="13" Data="M6.4,5 L12,10.6 L17.6,5 L19,6.4 L13.4,12 L19,17.6 L17.6,19 L12,13.4 L6.4,19 L5,17.6 L10.6,12 L5,6.4 Z" />
          </Button>
          <TextBlock Name="AboutVersionText"
                     Grid.Row="1"
                     Grid.ColumnSpan="2"
                     Foreground="#EAF7FBFF"
                     FontSize="11" />
          <TextBlock Grid.Row="2"
                     Grid.ColumnSpan="2"
                     Foreground="#C8E2EBF6"
                     FontSize="11"
                     Text="License: Apache-2.0" />
          <TextBlock Name="AboutGitHubLinkText"
                     Grid.Row="3"
                     Grid.ColumnSpan="2"
                     Cursor="Hand"
                     Foreground="#EAF7FBFF"
                     FontSize="11"
                     TextDecorations="Underline"
                     ToolTip.Tip="Open GitHub repository"
                     Text="GitHub: adiladiloglu/AA.Annotate" />
        </Grid>
      </Border>
      </primitives:Popup>
    </Canvas>
    <Grid Name="IdleWarningOverlay"
          IsVisible="False"
          Background="#A0000000">
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="420"
              Padding="18"
              Background="{StaticResource OverlayActiveBrush}"
              BorderBrush="{StaticResource OverlayBorderBrush}"
              BorderThickness="1"
              CornerRadius="10">
        <StackPanel Spacing="14">
          <TextBlock Name="IdleWarningTitleText"
                     Text="Annotation session is idle"
                     Foreground="White"
                     FontSize="18"
                     FontWeight="SemiBold" />
          <TextBlock Name="IdleWarningMessageText"
                     Foreground="#EAF7FBFF"
                     FontSize="13"
                     TextWrapping="Wrap" />
          <TextBlock Name="IdleWarningCountdownText"
                     Foreground="#EAF7FBFF"
                     FontSize="13"
                     FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button Name="IdleWarningContinueButton"
                    Classes="activeIconButton"
                    MinWidth="92"
                    Height="36"
                    Content="Continue" />
            <Button Name="IdleWarningDiscardButton"
                    Classes="iconButton"
                    MinWidth="92"
                    Height="36"
                    Content="Discard" />
            <Button Name="IdleWarningSendButton"
                    Classes="confirmButton"
                    MinWidth="92"
                    Height="36"
                    Content="Send" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
    <Grid Name="CompletionConfirmationOverlay"
          IsVisible="False"
          Focusable="True"
          Background="#A0000000">
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="420"
              Padding="18"
              Background="{StaticResource OverlayActiveBrush}"
              BorderBrush="{StaticResource OverlayBorderBrush}"
              BorderThickness="1"
              CornerRadius="10">
        <StackPanel Spacing="14">
          <TextBlock Name="CompletionConfirmationTitleText"
                     Text="Finish annotation session?"
                     Foreground="White"
                     FontSize="18"
                     FontWeight="SemiBold" />
          <TextBlock Name="CompletionConfirmationMessageText"
                     Foreground="#EAF7FBFF"
                     FontSize="13"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button Name="CompletionConfirmationCancelButton"
                    Classes="iconButton"
                    MinWidth="104"
                    Height="36"
                    Content="Keep editing" />
            <Button Name="CompletionConfirmationConfirmButton"
                    Classes="confirmButton"
                    MinWidth="104"
                    Height="36"
                    Content="Finish" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
