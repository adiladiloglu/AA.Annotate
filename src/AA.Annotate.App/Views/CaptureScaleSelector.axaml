<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="using:Avalonia.Controls.Primitives"
             x:Class="AA.Annotate.App.Views.CaptureScaleSelector"
             IsVisible="False">
  <Border Name="RootBorder"
          Height="44"
          Padding="10,7"
          CornerRadius="{StaticResource RadiusLarge}"
          Background="{StaticResource OverlaySolidBrush}"
          BorderBrush="{StaticResource OverlayBorderBrush}"
          BorderThickness="1">
    <Grid ColumnDefinitions="Auto,78,Auto" ColumnSpacing="8">
      <TextBlock Name="CaptureLabel"
                 VerticalAlignment="Center"
                 Foreground="{StaticResource PrimaryTextBrush}"
                 FontSize="12"
                 FontWeight="SemiBold" />
      <Border Name="ScaleBox"
              Grid.Column="1"
              Height="30"
              CornerRadius="7"
              Background="{StaticResource OverlayActiveBrush}"
              ToolTip.Tip="Output quality and scale">
        <Grid ColumnDefinitions="*,16">
          <TextBox Name="ScaleTextBox"
                   Classes="scaleTextBox"
                   Padding="0"
                   Text="100%"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   CaretBrush="{StaticResource PrimaryTextBrush}"
                   FontSize="12"
                   TextAlignment="Center"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center" />
          <Button Name="ScalePresetButton"
                  Grid.Column="1"
                  Classes="iconButton"
                  Width="16"
                  Height="30"
                  Cursor="Hand"
                  ToolTip.Tip="Scale presets">
            <PathIcon Width="9"
                      Height="9"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Foreground="{Binding $parent[Button].Foreground}"
                      Data="M6,8 L12,14 L18,8 Z" />
          </Button>
          <primitives:Popup Name="ScalePresetPopup"
                            PlacementTarget="{Binding #ScaleBox}"
                            Placement="BottomEdgeAlignedRight"
                            VerticalOffset="4"
                            IsLightDismissEnabled="True">
            <Border Width="96"
                    Padding="6"
                    CornerRadius="7"
                    Background="{StaticResource PanelSurfaceBrush}"
                    BorderBrush="{StaticResource OverlayBorderBrush}"
                    BorderThickness="1">
              <StackPanel Spacing="5">
                <Button Name="ScalePreset100Button" Classes="scalePresetButton" Content="100%" />
                <Button Name="ScalePreset75Button" Classes="scalePresetButton" Content="75%" />
                <Button Name="ScalePreset66Button" Classes="scalePresetButton" Content="66%" />
                <Button Name="ScalePreset50Button" Classes="scalePresetButton" Content="50%" />
                <Button Name="ScalePreset33Button" Classes="scalePresetButton" Content="33%" />
                <Button Name="ScalePreset25Button" Classes="scalePresetButton" Content="25%" />
              </StackPanel>
            </Border>
          </primitives:Popup>
        </Grid>
      </Border>
      <TextBlock Name="PixelSizeText"
                 Grid.Column="2"
                 MinWidth="92"
                 VerticalAlignment="Center"
                 Foreground="{StaticResource SecondaryTextBrush}"
                 FontSize="11"
                 TextAlignment="Right" />
    </Grid>
  </Border>
</UserControl>
